datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String?
  image         String?
  googleId      String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  schedules     EmailSchedule[]
}

model Sender {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String
  smtpHost      String          @default("smtp.ethereal.email")
  smtpPort      Int             @default(587)
  smtpUser      String
  smtpPass      String
  createdAt     DateTime        @default(now())
  schedules     EmailSchedule[]
}

model EmailSchedule {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId      String
  sender        Sender       @relation(fields: [senderId], references: [id])
  subject       String
  body          String
  totalLeads    Int
  minDelayMs    Int          @default(2000)
  hourlyLimit   Int          @default(100)
  scheduledAt   DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  jobs          EmailJob[]
}

model EmailJob {
  id            String        @id @default(uuid())
  scheduleId    String
  schedule      EmailSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  recipient     String
  subject       String
  body          String
  status        String        @default("SCHEDULED")
  scheduledAt   DateTime
  sentAt        DateTime?
  attempts      Int           @default(0)
  errorMessage  String?
  etherealUrl   String?
  bullJobId     String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([scheduledAt])
}
